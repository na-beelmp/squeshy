PROJECT_NAME = "PVCop internal API documentation"

INPUT             = @PROJECT_SOURCE_DIR@/include/pvcop
INPUT            += @PROJECT_SOURCE_DIR@/src

OUTPUT_DIRECTORY = @CMAKE_CURRENT_BINARY_DIR@/internal

FULL_PATH_NAMES  = NO
RECURSIVE        = YES
EXTRACT_ALL      = YES
EXTRACT_STATIC	 = YES
CALL_GRAPH       = YES
CALLER_GRAPH     = YES
INTERNAL_DOCS    = YES

GENERATE_HTML  = YES
GENERATE_LATEX = NO
GENERATE_MAN   = NO
